# ============================================================
# .gitignore — hlt-grpo-countdown
# Rule: git keeps CODE + small RESULTS (json, png, logs we copied).
# Big or regenerable things stay out: model weights, checkpoints, zips, envs.
# ============================================================

# --- Python / environments ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Training outputs (big: LoRA weights + optimizer states) ---
# The adapter lives on the laptop + Kaggle Dataset, not on GitHub.
checkpoints/
*.safetensors
*.pt
*.pth
*.bin

# --- Raw run logs (the important ones are copied into results/stageX/) ---
logs/
wandb/

# --- Archives / downloads from Kaggle ---
*.zip
kaggle_out/

# --- Secrets (HF / GitHub / Kaggle tokens) ---
.env
kaggle.json